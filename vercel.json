{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rootDirectory": "frontend",
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/main.py" },
    { "src": "/(.*)", "dest": "frontend/dist/index.html" }
  ]
}
